# Copy to .env and adjust. Used by docker compose variable substitution.

DATABASE_URL=postgresql://rkive:rkive@postgres:5432/rkive
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=org-default

# --- GEMINI CONFIGURATION ---
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_CHAT_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=models/gemini-embedding-001
EMBEDDING_DIM=768

