# Copy to .env and adjust. Used by docker compose variable substitution.

DATABASE_URL=postgresql://rkive:rkive@postgres:5432/rkive
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=org-default

# --- LLM CONFIGURATION ---
# Chat + embeddings model names
LLM_CHAT_MODEL=llama3.1
EMBEDDING_MODEL=nomic-embed-text

# Optional: only needed if your endpoint requires auth
LLM_API_KEY=

# Optional: only needed if your embedding endpoint requires auth
EMBEDDING_API_KEY=

# Endpoints
# Chat endpoint (cloud)
LLM_BASE_URL=http://host.docker.internal:11434

# Embeddings endpoint (often local Docker)
# If omitted, defaults to LLM_BASE_URL
EMBEDDING_BASE_URL=http://host.docker.internal:11434

# (Gemini embeddings used to be 3072; nomic-embed-text is typically 768)
EMBEDDING_DIM=768

# QDRANT_API_KEY=
