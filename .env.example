# Copy to .env and adjust. Used by docker compose variable substitution.

# Ollama (run on host or another container). Linux Docker uses host-gateway below in compose.
OLLAMA_BASE_URL=http://host.docker.internal:11434

OLLAMA_CHAT_MODEL=llama3.2
OLLAMA_EMBED_MODEL=nomic-embed-text

# Must match your embedding model output size (nomic-embed-text = 768).
EMBEDDING_DIM=768

QDRANT_COLLECTION=org-default
# QDRANT_API_KEY=
